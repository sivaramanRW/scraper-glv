# Copy to .env (never committed). Read by ecosystem.config.js and scrape.py; a real environment variable wins.

# Qwen3-VL captcha API fleet: comma-separated base URLs (/v1/describe/base64 is appended)
CAPTCHA_API_URLS=http://192.168.52.115:8091,http://192.168.52.115:8093,http://192.168.52.115:8094
# bearer token for that API (VLM_API_TOKENS in the vlm-api .env) ...
CAPTCHA_API_TOKEN=
# ... or, on the box that runs the API, the path of its .env to read the token from
#CAPTCHA_API_TOKEN_FILE=/home/randomwalk/Documents/vlm-api/.env

# expected captcha length (0 = no check)
CAPTCHA_LEN=6

# fallback when CAPTCHA_API_URLS is empty: local Ollama vision model
#OLLAMA_URL=http://localhost:11434
#CAPTCHA_MODEL=qwen2.5vl:7b

# How the API calls reach the site (the captcha API calls above always go direct, it is on the LAN):
#   ROTATION_IP  through PROXY_URL (empty = direct). With the Android phone: PROXY_URL=socks5://<phone ip>:1080 (Every Proxy
#                over USB tethering, see README "Mobile proxy"); ROTATE_EVERY_S > 0 starts the pm2 job land-phone-rotate,
#                which toggles the phone's mobile data over adb every N seconds for a new mobile IP
#   ONLINE_PROXY worker k uses the k-th of ONLINE_PROXY_URLS (http://user:pass@host:port,...); the rotator is not started
IPS_PROXY_METHOD=ROTATION_IP
PROXY_URL=
#PROXY_URL=socks5://192.168.59.64:1080
#ROTATE_EVERY_S=600
#ROTATE_MODE=data          # data (keeps the USB tether up) | airplane
#ADB_SERIAL=               # only when several phones are attached
#ONLINE_PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port,http://user:pass@host3:port

# check-areg pacing: seconds between calls, calls per account visit, and the caps "window seconds:max calls" (the site's
# 50/1h, 125/4h, 150/6h, 175/8h, 250/24h each with a margin). An account with less than ACCOUNT_MIN_VISIT calls of room is skipped.
#CALL_DELAY_S=5
#ACCOUNT_BUDGET=40
#ACCOUNT_MIN_VISIT=20
#CALL_CAPS=3720:40,14520:112,21720:135,28920:157,86520:225
