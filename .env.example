# Copy to .env (never committed). Read by ecosystem.config.js and scrape.py; a real environment variable wins.

# Qwen3-VL captcha API fleet: comma-separated base URLs (/v1/describe/base64 is appended)
CAPTCHA_API_URLS=http://192.168.52.115:8091,http://192.168.52.115:8093,http://192.168.52.115:8094
# bearer token for that API (VLM_API_TOKENS in the vlm-api .env) ...
CAPTCHA_API_TOKEN=
# ... or, on the box that runs the API, the path of its .env to read the token from
#CAPTCHA_API_TOKEN_FILE=/home/randomwalk/Documents/vlm-api/.env

# expected captcha length (0 = no check)
CAPTCHA_LEN=6

# fallback when CAPTCHA_API_URLS is empty: local Ollama vision model
#OLLAMA_URL=http://localhost:11434
#CAPTCHA_MODEL=qwen2.5vl:7b
